{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App (staging)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file", "env/staging.json"]
    },
    {
      "name": "App (prod)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "args": ["--dart-define-from-file", "env/prod.json"]
    },
    {
      "name": "Admin (staging) — Chrome",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_admin.dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define-from-file", "env/staging.json",
        "--web-browser-flag", "--disable-web-security",
        "--web-browser-flag", "--user-data-dir=/tmp/ql-admin-dev"
      ]
    },
    {
      "name": "Admin (prod) — Chrome",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_admin.dart",
      "deviceId": "chrome",
      "flutterMode": "release",
      "args": ["--dart-define-from-file", "env/prod.json"]
    }
  ]
}
